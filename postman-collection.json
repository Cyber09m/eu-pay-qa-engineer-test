{
  "info": {
    "name": "EU Pay QA Test API",
    "description": "Test collection for QA Engineer assignment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newmerchant@test.com\",\n  \"password\": \"SecurePass123!\",\n  \"business_name\": \"My Test Business\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('auth_token', response.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"merchant@test.com\",\n  \"password\": \"Test123!\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Get All Payments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/payments",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "payments"]
            }
          }
        },
        {
          "name": "Get Payment by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/payments/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "payments", "1"]
            }
          }
        },
        {
          "name": "Create Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50.00,\n  \"currency\": \"EUR\",\n  \"customer_email\": \"customer@example.com\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/payments",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "payments"]
            }
          }
        },
        {
          "name": "Create Payment - Edge Case: Large Amount",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 999999999,\n  \"currency\": \"EUR\",\n  \"customer_email\": \"customer@example.com\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/payments",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "payments"]
            }
          }
        },
        {
          "name": "Create Payment - Negative Amount (Should Fail)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": -50.00,\n  \"currency\": \"EUR\",\n  \"customer_email\": \"customer@example.com\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/payments",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "payments"]
            }
          }
        }
      ]
    }
  ]
}
